<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BookWheel</RootNamespace>
    <!-- CI (ci.yml) validates this value against ^[0-9]+(\.[0-9]+){0,3}$ before appending a
         -ci.<run>+<sha> suffix; a version format change here can silently break 4 of 7 CI jobs. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">1.11.0</InformationalVersion>
  </PropertyGroup>
</Project>
