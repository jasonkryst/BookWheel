<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BookWheel</RootNamespace>
    <!-- CI (ci.yml) validates this value against ^[0-9]+(\.[0-9]+){0,3}$ before appending a
         -ci.<run>+<sha> suffix; a version format change here can silently break 4 of 7 CI jobs. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">3.6.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 pins EFCore to 10.0.4, while
         Microsoft.EntityFrameworkCore.Design 10.0.12 pulls in EFCore 10.0.12; pin these
         explicitly so both projects resolve to the same assembly version (CS1705). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>
</Project>
