<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BookWheel</RootNamespace>
    <!-- CI (ci.yml) validates this value against ^[0-9]+(\.[0-9]+){0,3}$ before appending a
         -ci.<run>+<sha> suffix; a version format change here can silently break 4 of 7 CI jobs. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">2.13.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 9.0.4 pins EFCore to 9.0.1, while
         Microsoft.EntityFrameworkCore.Design 9.0.19 pulls in EFCore 9.0.19; pin these
         explicitly so both projects resolve to the same assembly version (CS1705). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19" />
  </ItemGroup>
</Project>
