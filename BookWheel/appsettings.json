{
  "ConnectionStrings": {
    "BookWheel": ""
  },
  "DataProtection": {
    "KeyDirectory": ""
  },
  "Security": {
    "LogRetentionDays": 14,
    "LogMaxFileSizeMb": 5,
    "UsernameLockoutThreshold": 5,
    "UsernameLockoutMinutes": 3,
    "AlwaysSecureCookie": false,
    "ContentSecurityPolicyReportOnly": true,
    "MetadataLookupRateLimitPerMinute": 30
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "Observability": {
    "EnableRequestCorrelationLogging": true,
    "EnableStartupDiagnostics": true,
    "LogShipping": {
      "Enabled": false,
      "EndpointUrl": "",
      "ApiKey": "",
      "BatchSize": 100,
      "PollIntervalSeconds": 30
    }
  },
  "BookMetadata": {
    "TitleSearchResultLimit": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "BaseUrl": ""
  },
  "Analytics": {
    "GoogleAnalyticsId": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromAddress": "",
    "FromName": "Book Wheel"
  },
  "RetailerLinks": {
    "Retailers": [
      {
        "Name": "Google Books",
        "IsbnUrlTemplate": "https://books.google.com/books?vid=ISBN{isbn}",
        "TextUrlTemplate": "https://books.google.com/books?q={query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "",
        "Locales": []
      },
      {
        "Name": "Open Library",
        "IsbnUrlTemplate": "https://openlibrary.org/isbn/{isbn}",
        "TextUrlTemplate": "https://openlibrary.org/search?q={query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "",
        "Locales": []
      },
      {
        "Name": "Goodreads",
        "TextUrlTemplate": "https://www.goodreads.com/search?q={query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "",
        "Locales": []
      },
      {
        "Name": "Amazon",
        "TextUrlTemplate": "https://www.amazon.com/s?k={query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "tag",
        "Locales": []
      },
      {
        "Name": "Amazon",
        "TextUrlTemplate": "https://www.amazon.es/s?k={query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "tag",
        "Locales": ["es"]
      },
      {
        "Name": "Amazon",
        "TextUrlTemplate": "https://www.amazon.pl/s?k={query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "tag",
        "Locales": ["pl"]
      },
      {
        "Name": "Barnes & Noble",
        "TextUrlTemplate": "https://www.barnesandnoble.com/s/{query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "",
        "Locales": ["en"]
      },
      {
        "Name": "Bookshop.org",
        "TextUrlTemplate": "https://bookshop.org/beta-search?keywords={query}",
        "Enabled": true,
        "AffiliateTag": "",
        "AffiliateParam": "",
        "Locales": ["es", "pl"]
      }
    ]
  }
}
